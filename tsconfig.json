{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "useDefineForClassFields": true,

    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@sculpt/*": ["./packages/*/src/index.ts"]
    }
  },

  "include": [
    "apps",
    "packages",
    "tests",
    "vite.config.ts",
    "eslint.config.js"
  ]
}